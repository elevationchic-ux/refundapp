# ─── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET="change-me"

# ─── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.litigeflow.fr"

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Clés disponibles sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Secret du webhook Stripe (obtenu via : stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price ID du plan Premium (créer dans Stripe Dashboard > Products)
STRIPE_PRICE_PREMIUM="price_..."
