generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  AGENT
  ADMIN
}

enum ClaimStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  REJECTED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  role           Role     @default(CLIENT)
  claims         Claim[]  @relation("ClaimOwner")
  assignedClaims Claim[]  @relation("ClaimAgent")
  createdAt      DateTime @default(now())
}

model Claim {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("ClaimOwner", fields: [userId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       User?       @relation("ClaimAgent", fields: [agentId], references: [id], onDelete: SetNull)
  amount      Decimal     @db.Decimal(12, 2)
  currency    String      @default("EUR")
  reference   String?
  status      ClaimStatus @default(PENDING)
  description String
  date        DateTime
  evidence    Evidence[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model Evidence {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([claimId])
}
